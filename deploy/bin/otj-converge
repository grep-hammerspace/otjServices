#!/usr/bin/env bash
# otj-converge <sha> [--check]
# otj-converge --version
#
# The one script on the box (ansible-migration-plan.md §4.2). Deploys a release, re-applies the
# box's config, and fixes drift, which are all the same thing: pull the image for <sha>, take the
# playbook out of it, and run it against this box. Run as root, by CI through `ssm send-command`
# or by hand in an SSM session. --check shows what would change and changes nothing.
#
# Deliberately plain and top to bottom, so it can be read in an emergency. It is installed by
# hand once (ansible-deploy-checklist.md step 4), and after that by the playbook, last, so a broken
# copy only affects the next run.
set -euo pipefail

VERSION=1
REGION="${OTJ_REGION:-eu-west-2}"
REPO="${OTJ_IMAGE_REPO:-378849626815.dkr.ecr.eu-west-2.amazonaws.com/otj-hours-api}"
RELEASES=/opt/otj/releases
KEEP=5

die() { echo "otj-converge: $*" >&2; exit 1; }

if [[ "${1:-}" == "--version" ]]; then
  echo "otj-converge $VERSION"
  exit 0
fi

sha="${1:-}"
mode="${2:-}"
# The SHA arrives from a workflow input. Only a full lowercase commit SHA gets anywhere near a
# command line.
[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || die "usage: otj-converge <40-char commit sha> [--check]"
[[ -z "$mode" || "$mode" == "--check" ]] || die "unknown option '$mode'"
[[ $EUID -eq 0 ]] || die "run as root"

image="$REPO:$sha"
dest="$RELEASES/$sha"

echo "==> otj-converge $VERSION: $sha${mode:+ ($mode)}"

# 1. What this script itself needs. A no-op after the first run; the playbook owns them after.
export DEBIAN_FRONTEND=noninteractive
if ! command -v ansible-playbook >/dev/null || ! command -v podman >/dev/null; then
  apt-get update -q
  apt-get install -y -q ansible-core podman
fi
command -v aws >/dev/null || die "the AWS CLI is missing: ansible-deploy-checklist.md step 4"

# 2–3. The release's playbook, read out of its image. As root, into root's storage, because on a
# blank box otjapp doesn't exist yet. The app role pulls again into otjapp's storage, where the
# containers actually run. Kept on disk so a rollback or a re-run doesn't need to extract again.
if [[ ! -d "$dest" ]]; then
  echo "==> Extracting the playbook from $image"
  aws ecr get-login-password --region "$REGION" \
    | podman login --username AWS --password-stdin "${REPO%%/*}" >/dev/null
  podman pull --quiet "$image" >/dev/null
  mkdir -p "$RELEASES"
  tmp=$(mktemp -d "$RELEASES/.extract.XXXXXX")
  cid=$(podman create "$image")
  podman cp "$cid:/deploy/." "$tmp/"
  podman rm "$cid" >/dev/null
  podman rmi "$image" >/dev/null || true
  mv "$tmp" "$dest"
fi

# Keep the $KEEP most recently USED releases. Touching this one first means a rollback to an old
# SHA can't prune the release it's about to run. Directory names are hex SHAs, so ls is safe here.
touch "$dest"
rm -rf "$RELEASES"/.extract.*
# shellcheck disable=SC2012
ls -1dt "$RELEASES"/*/ | tail -n +$((KEEP + 1)) | xargs -r rm -rf

# 4–5. Apply. The apt copy of ansible-playbook, by full path: it's the version the roles are
# written for.
cd "$dest/ansible"
args=(-i inventory.ini site.yml -e "image_tag=$sha")
[[ "$mode" == "--check" ]] && args+=(--check --diff)
exec /usr/bin/ansible-playbook "${args[@]}"
