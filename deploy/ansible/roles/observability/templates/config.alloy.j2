// Written by the observability role for release {{ image_tag }}. Don't edit on the box: the next
// converge puts it back. How to read what it sends: deploy/ansible/README.md.
//
// Two pipelines, one token: the journal to Grafana Cloud Loki (logs), and the host's CPU, memory,
// disk and network to Grafana Cloud Prometheus (metrics, at the end of this file).
//
// Three trails, all read from the journal, and nothing else from it leaves the box:
//   _SYSTEMD_UNIT=haproxy.service   service="edge", proxy="haproxy"
//   CONTAINER_NAME=hours-api        service="hours-api"
//   CONTAINER_NAME=admin-api        service="admin-api"
// Labels stay low-cardinality. userId, path and IP stay in the line, for LogQL line filters.

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "haproxy\\.service"
    target_label  = "service"
    replacement   = "edge"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "haproxy\\.service"
    target_label  = "proxy"
    replacement   = "haproxy"
  }

  rule {
    source_labels = ["__journal_container_name"]
    regex         = "(hours-api|admin-api)"
    target_label  = "service"
  }

  // Everything else in the journal stays on the box.
  rule {
    source_labels = ["service"]
    regex         = "edge|hours-api|admin-api"
    action        = "keep"
  }
}

// The system journal and otjapp's user journal, both under this one directory.
loki.source.journal "box" {
  path          = "/var/log/journal"
  relabel_rules = loki.relabel.journal.rules
  labels        = {env = "{{ loki_labels.env }}", host = "{{ loki_labels.host }}"}
  forward_to    = [loki.process.scrub.receiver]
}

// HAProxy writes the client address already truncated (IPv4 /24, IPv6 /48) at the start of each
// access-log line, and the full address as a trailing full_src= field for the local journal only
// (deploy/haproxy/haproxy.cfg). That field is cut here. Any line still carrying one afterwards is
// dropped, not sent, so a change to the format fails closed.
loki.process "scrub" {
  stage.replace {
    expression = "( full_src=\\S+)$"
    replace    = ""
  }

  stage.drop {
    expression          = "full_src="
    drop_counter_reason = "full_client_address"
  }

  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = "{{ loki_push_url }}"

    basic_auth {
      username = "{{ loki_user }}"
      // Write-only (logs:write and metrics:write, this stack). Rendered from Parameter Store into
      // /run/otj/alloy.env at unit start by otj-render-env; no file Ansible writes ever holds it.
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}

// ── Host metrics ─────────────────────────────────────────────────────────────────────────────
// The box as a whole, not per container. Read from the host's /proc and /sys, mounted read-only
// under /host (alloy.container). Nothing else of the host is mounted: disk usage is read through
// /var/lib/alloy, which is on the root filesystem, so the host's / is never mounted into Alloy.
prometheus.exporter.unix "box" {
  procfs_path              = "/host/proc"
  sysfs_path               = "/host/sys"
  // statfs("/var/lib/alloy/") reports the root filesystem, which is the only disk the box has.
  rootfs_path              = "/var/lib/alloy"
  udev_data_path           = "/run/udev/data"
  set_collectors           = ["cpu", "diskstats", "filesystem", "loadavg", "meminfo", "netdev", "pressure", "stat", "uname", "vmstat"]
  include_exporter_metrics = false

  // "/" only. Any other mount point would be measured through the same directory, and be wrong.
  filesystem {
    mount_points_exclude = "^/.+"
  }

  netdev {
    device_exclude = "^(lo|veth.*|cni.*|podman.*)$"
  }
}

// job and instance as Grafana's Linux dashboards expect them.
discovery.relabel "box" {
  targets = prometheus.exporter.unix.box.targets

  rule {
    target_label = "instance"
    replacement  = "{{ loki_labels.host }}"
  }

  rule {
    target_label = "job"
    replacement  = "integrations/node_exporter"
  }
}

prometheus.scrape "box" {
  targets         = discovery.relabel.box.output
  scrape_interval = "{{ metrics_scrape_interval }}"
  // No longer than the shortest interval used (the rehearsal's); the default 10s would be refused.
  scrape_timeout  = "5s"
  forward_to      = [prometheus.relabel.keep.receiver]
}

// Only what the dashboards chart. The free tier counts active series, and the exporter's
// defaults produce many more than these.
prometheus.relabel "keep" {
  rule {
    source_labels = ["__name__"]
    regex         = "up|node_(cpu_seconds_total|load(1|5|15)|memory_(MemTotal|MemAvailable|MemFree|Buffers|Cached|SwapTotal|SwapFree)_bytes|filesystem_(size|avail)_bytes|disk_(read|written)_bytes_total|disk_io_time_seconds_total|network_(receive|transmit)_(bytes|errs|drop)_total|pressure_(cpu|memory|io)_(waiting|stalled)_seconds_total|vmstat_oom_kill|boot_time_seconds|uname_info)"
    action        = "keep"
  }

  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  external_labels = {env = "{{ loki_labels.env }}"}

  endpoint {
    url = "{{ prom_remote_write_url }}"

    basic_auth {
      username = "{{ prom_user }}"
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}
