loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "haproxy\\.service"
    target_label  = "service"
    replacement   = "edge"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "haproxy\\.service"
    target_label  = "proxy"
    replacement   = "haproxy"
  }

  rule {
    source_labels = ["__journal_container_name"]
    regex         = "(hours-api|admin-api)"
    target_label  = "service"
  }

  // Everything else in the journal stays on the box.
  rule {
    source_labels = ["service"]
    regex         = "edge|hours-api|admin-api"
    action        = "keep"
  }
}

loki.source.journal "box" {
  path          = "/var/log/journal"
  relabel_rules = loki.relabel.journal.rules
  labels        = {env = "{{ loki_labels.env }}", host = "{{ loki_labels.host }}"}
  forward_to    = [loki.process.scrub.receiver]
}

// HAProxy puts the truncated address first and the full one last as full_src=. Cut it, and drop any
// line that still has one, so a format change fails closed.
loki.process "scrub" {
  stage.replace {
    expression = "( full_src=\\S+)$"
    replace    = ""
  }

  stage.drop {
    expression          = "full_src="
    drop_counter_reason = "full_client_address"
  }

  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = "{{ loki_push_url }}"

    basic_auth {
      username = "{{ loki_user }}"
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}

prometheus.exporter.unix "box" {
  procfs_path              = "/host/proc"
  sysfs_path               = "/host/sys"
  // statfs("/var/lib/alloy/") reports the root filesystem.
  rootfs_path              = "/var/lib/alloy"
  udev_data_path           = "/run/udev/data"
  set_collectors           = ["cpu", "diskstats", "filesystem", "loadavg", "meminfo", "netdev", "pressure", "stat", "uname", "vmstat"]
  include_exporter_metrics = false

  // "/" only: any other mount point would be measured through the same directory.
  filesystem {
    mount_points_exclude = "^/.+"
  }

  netdev {
    device_exclude = "^(lo|veth.*|cni.*|podman.*)$"
  }
}

discovery.relabel "box" {
  targets = prometheus.exporter.unix.box.targets

  rule {
    target_label = "instance"
    replacement  = "{{ loki_labels.host }}"
  }

  rule {
    target_label = "job"
    replacement  = "integrations/node_exporter"
  }
}

prometheus.scrape "box" {
  targets         = discovery.relabel.box.output
  scrape_interval = "{{ metrics_scrape_interval }}"
  // Must not exceed the shortest scrape interval used (the rehearsal's).
  scrape_timeout  = "5s"
  forward_to      = [prometheus.relabel.keep.receiver]
}

// Only what the dashboards chart: the free tier counts active series.
prometheus.relabel "keep" {
  rule {
    source_labels = ["__name__"]
    regex         = "up|node_(cpu_seconds_total|load(1|5|15)|memory_(MemTotal|MemAvailable|MemFree|Buffers|Cached|SwapTotal|SwapFree)_bytes|filesystem_(size|avail)_bytes|disk_(read|written)_bytes_total|disk_io_time_seconds_total|network_(receive|transmit)_(bytes|errs|drop)_total|pressure_(cpu|memory|io)_(waiting|stalled)_seconds_total|vmstat_oom_kill|boot_time_seconds|uname_info)"
    action        = "keep"
  }

  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  external_labels = {env = "{{ loki_labels.env }}"}

  endpoint {
    url = "{{ prom_remote_write_url }}"

    basic_auth {
      username = "{{ prom_user }}"
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}
