[Unit]
Description=otjServices admin API (invite codes)
After=network-online.target
Wants=network-online.target

[Container]
Image={{ app_image }}
ContainerName=admin-api
Environment=APP_ROLE=admin
# Loopback only, and a literal. AdminIdentityFilter can trust Tailscale-User-Login only because
# tailscale serve is the sole process that reaches this port.
PublishPort=127.0.0.1:8946:8946
EnvironmentFile=%t/otj/admin-api.env
LogDriver=journald
HealthCmd=curl -f http://localhost:8946/health || exit 1
HealthInterval=15s
HealthRetries=3

[Service]
ExecStartPre=%h/.local/bin/otj-render-env admin-api
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
