[Unit]
Description=otjServices hours-api
After=network-online.target
Wants=network-online.target

[Container]
Image={{ app_image }}
ContainerName=hours-api
# Loopback only, and a literal so it can't be widened by accident.
PublishPort=127.0.0.1:8945:8945
EnvironmentFile=%t/otj/hours-api.env
# Alloy reads the logs from the journal.
LogDriver=journald
HealthCmd=curl -f http://localhost:8945/health || exit 1
HealthInterval=15s
HealthRetries=3

[Service]
ExecStartPre=%h/.local/bin/otj-render-env hours-api
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
