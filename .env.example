# Copy to .env (gitignored) and fill in. bootstrap.sh refuses to start while any of these is empty.

# Mongo's root user, created on the first start of the data volume. Changing them later needs
# `clean-mongo`, which wipes the data.
MONGO_USER=otj
MONGO_PASSWORD=

# Turns your notes into activity rows. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Only for running target/app.jar outside compose; the app doesn't read this file, so export it.
# MONGO_URI=mongodb://otj:<password>@localhost:27017/otjdb?authSource=admin
