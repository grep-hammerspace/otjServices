<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Never default the drivers to DEBUG: that once put Microsoft flow tokens in the production
       log. OTJ_DRIVER_LOG_LEVEL=DEBUG enables it on purpose, until the next restart. -->
  <logger name="com.github.grepHammerspace.web.OtjDriver"
          level="${OTJ_DRIVER_LOG_LEVEL:-INFO}"/>

  <logger name="org.mongodb.driver" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
